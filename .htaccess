Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(bootstrap|config|resources|INDICACIONES)(/|$) - [F,L,NC]
    RewriteRule (^|/)\. - [F,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>
<FilesMatch "^(\.env.*|.*\.sql)$">
    Require all denied
</FilesMatch>
